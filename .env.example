# Copy to .env and fill in. Never commit .env.
META_API_KEY=

# Optional: sign in with GitHub or Google (see "Accounts" in the README)
RESONANCE_GITHUB_CLIENT_ID=
RESONANCE_GITHUB_CLIENT_SECRET=
RESONANCE_GOOGLE_CLIENT_ID=
RESONANCE_GOOGLE_CLIENT_SECRET=
# Optional: the address people open, when it is not the one the server sees (e.g. behind a proxy)
RESONANCE_PUBLIC_URL=
# Optional: spend limits on paid model calls (see "Spend limits" in the README)
RESONANCE_DAILY_ANALYSES=5
RESONANCE_DAILY_DIAGNOSES=3
RESONANCE_DAILY_BUDGET_USD=10
# largest upload (clip + sensor file + manual), in MB
RESONANCE_MAX_UPLOAD_MB=500
# analyses that run at once (each ~2 cores, ~3 GB)
RESONANCE_WORKERS=1
